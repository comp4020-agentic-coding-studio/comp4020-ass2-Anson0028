---
import { getPublishedCollection } from "astro-course-university/content";
import { formatCourseDate } from "../lib/dates";

const sessions = await getPublishedCollection("sessions");
const visible = sessions.sort((a, b) => a.data.week - b.data.week);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<table class="tutorials">
  <thead>
    <tr>
      <th scope="col">Week</th>
      <th scope="col">Tutorial</th>
      <th scope="col">You leave with</th>
    </tr>
  </thead>
  <tbody>
    {
      visible.map((session) => (
        <tr>
          <td>
            {session.data.week}
            <small>{formatCourseDate(session.data.date)}</small>
          </td>
          <th scope="row">
            <a href={`${base}/sessions/${session.id}/`}>{session.data.title}</a>
          </th>
          <td>{(session.data as { measures?: string }).measures}</td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .tutorials {
    width: 100%;
    border-collapse: collapse;
  }

  .tutorials th,
  .tutorials td {
    padding: 0.6rem 0.75rem 0.6rem 0;
    text-align: start;
    vertical-align: top;
    border-bottom: 1px solid var(--at-divider);
  }

  .tutorials thead th {
    color: var(--at-text-secondary);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .tutorials small {
    display: block;
    color: var(--at-text-secondary);
    white-space: nowrap;
  }

  @media (max-width: 36rem) {
    .tutorials thead {
      display: none;
    }

    .tutorials tr {
      display: grid;
      padding-block: 0.6rem;
      border-bottom: 1px solid var(--at-divider);
    }

    .tutorials th,
    .tutorials td {
      padding: 0.1rem 0;
      border: 0;
    }
  }
</style>
