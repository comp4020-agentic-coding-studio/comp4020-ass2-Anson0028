---
import { getPublishedCollection } from "astro-course-university/content";
import { formatCourseDate } from "../lib/dates";

const assessments = await getPublishedCollection("assessments");
const visible = assessments.sort((a, b) => a.data.due.getTime() - b.data.due.getTime());
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const consumed = new Set(visible.map((a) => String((a.data as { consumes?: string }).consumes ?? "")));
const last = visible.filter((a) => (a.data as { consumes?: string }).consumes && !consumed.has(a.id)).at(-1)?.id;
---

<ol class="marks">
  {
    visible.map((assessment) => (
      <li class={assessment.id === last ? "verdict" : ""}>
        <a href={`${base}/assessments/${assessment.id}/`}>
          <span class="pct">{assessment.data.weight != null ? `${assessment.data.weight}%` : "—"}</span>
          <span class="when">Week {assessment.data.week}</span>
          <h2 class="t">{assessment.data.title}</h2>
          <span class="tag">
            Due {formatCourseDate(assessment.data.due)}
            {assessment.data.draft && " · Draft"}
          </span>
          {assessment.data.description && <p class="d">{assessment.data.description}</p>}
        </a>
      </li>
    ))
  }
</ol>

<style>
  .marks {
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--at-divider);
  }

  .marks li {
    border-top: 1px solid var(--at-divider);
  }

  .marks a {
    display: grid;
    grid-template-columns: 4.75rem minmax(0, 1fr) max-content;
    gap: 0.15rem 1.25rem;
    align-items: baseline;
    padding: 1rem 0.9rem;
    color: inherit;
    text-decoration: none;
  }

  .pct {
    grid-row: 1;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 1.85rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .when,
  .tag {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .when {
    grid-row: 2;
    grid-column: 3;
    justify-self: end;
    opacity: 0.75;
  }

  .tag {
    grid-row: 1;
    grid-column: 3;
    justify-self: end;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    opacity: 0.75;
  }

  .t {
    grid-row: 1;
    grid-column: 2;
    margin: 0;
    color: light-dark(var(--at-secondary), var(--at-heading));
    font-size: 1.2rem;
    line-height: 1.3;
  }

  .d {
    grid-row: 2;
    grid-column: 2;
    margin: 0.15rem 0 0;
    font-size: 0.95rem;
    opacity: 0.82;
  }

  .marks a:hover .t,
  .marks a:focus-visible .t {
    text-decoration: underline;
  }

  .marks li.verdict a {
    background: var(--at-bg-alt);
    box-shadow: inset 0.3rem 0 0 var(--at-primary);
  }

  .marks li.verdict .d,
  .marks li.verdict .tag,
  .marks li.verdict .when {
    opacity: 0.9;
  }

  .marks li.verdict a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -4px;
  }

  @media (max-width: 40rem) {
    .marks a {
      grid-template-columns: 3.6rem minmax(0, 1fr);
      padding-inline: 0.6rem;
    }

    .pct {
      font-size: 1.5rem;
    }

    .tag {
      grid-row: 3;
      grid-column: 2;
      justify-self: start;
    }

    .when {
      grid-row: 4;
      grid-column: 2;
      justify-self: start;
    }

    .d {
      grid-column: 2;
    }
  }
</style>
