---
const printed = [
  { runs: 1, median: 69.3 },
  { runs: 5, median: 69.3 },
  { runs: 15, median: 81.5 },
  { runs: 51, median: 78.2 },
  { runs: 101, median: 78.0 },
  { runs: 501, median: 73.7 },
];
---

<figure class="drift">
  <table>
    <thead>
      <tr>
        <th scope="col">Runs</th>
        <th scope="col">Printed above</th>
        <th scope="col">In your browser</th>
      </tr>
    </thead>
    <tbody>
      {printed.map((row) => (
        <tr data-runs={row.runs}>
          <th scope="row">{row.runs}</th>
          <td>{row.median.toFixed(1)} s</td>
          <td class="live">not run yet</td>
        </tr>
      ))}
    </tbody>
  </table>
  <p class="run-it">
    <button type="button" id="run-drift">Run 501 and watch the median move</button>
    <span id="drift-status" aria-live="polite"></span>
  </p>
  <figcaption>
    The 150 ms player, the same rules, in your browser. The first press uses the
    page's seeds, and the two columns still will not agree exactly: the printed
    one was measured in Node on one Apple laptop, and your browser rounds
    <code>Math.sin</code> a little differently, so a few runs end differently. Every press after that draws new
    seeds. That the median moves is the point. Where it lands is not.
  </figcaption>
</figure>

<script>
  type Shared = Window & { slopRulesUnreachable?: boolean };
  const RESUME = "slop-resume";
  const shared = () => window as Shared;

  function wire() {
    const probe = document.getElementById("run-drift");
    if (!probe || probe.dataset.wired) return;
    probe.dataset.wired = "true";
    const button = document.getElementById("run-drift") as HTMLButtonElement;
    const status = document.getElementById("drift-status") as HTMLElement;
    const rows = [...document.querySelectorAll<HTMLElement>(".drift tbody tr")];
    let batch = 0;
    button.addEventListener("click", async () => {
      if (button.getAttribute("aria-disabled") === "true") return;
      if (shared().slopRulesUnreachable) {
        if (!navigator.onLine) {
          status.textContent = "Still offline, so the page stays as it is. Press again once you are back online.";
          return;
        }
        try {
          sessionStorage.setItem(RESUME, button.id);
        } catch {}
        location.reload();
        return;
      }
      button.setAttribute("aria-disabled", "true");
      status.textContent = "Running…";
      let survivalTimes: typeof import("../scripts/run-51").survivalTimes;
      let median: typeof import("../scripts/run-51").median;
      try {
        ({ survivalTimes, median } = await import("../scripts/run-51"));
      } catch {
        shared().slopRulesUnreachable = true;
        status.textContent = "Could not load the rules, so nothing ran. Once you are back online, press again to reload the page.";
        button.textContent = "Reload and try again";
        button.removeAttribute("aria-disabled");
        return;
      }
      const started = performance.now();
      const most = Math.max(...rows.map((row) => Number(row.dataset.runs)));
      const times = await survivalTimes(150, most, batch);
      const medians = rows.map((row) => {
        const m = median(times.slice(0, Number(row.dataset.runs))) / 1000;
        row.querySelector(".live")!.textContent = `${m.toFixed(1)} s`;
        return m;
      });
      const seconds = ((performance.now() - started) / 1000).toFixed(1);
      const spread = (Math.max(...medians) - Math.min(...medians)).toFixed(1);
      status.textContent = `${most} runs in ${seconds} s${batch === 0 ? "" : `, batch ${batch + 1} on new seeds`}. The median moved by ${spread} s as the runs were added. It was the same player and the same game the whole time.`;
      batch++;
      button.textContent = "Run 501 on new seeds";
      button.removeAttribute("aria-disabled");
    });
    if (shared().slopRulesUnreachable) {
      status.textContent = "The rules did not load earlier on this visit, so pressing reloads the page first.";
      button.textContent = "Reload and try again";
    }
    let resume: string | null = null;
    try {
      resume = sessionStorage.getItem(RESUME);
      if (resume === button.id) sessionStorage.removeItem(RESUME);
    } catch {}
    if (resume === button.id) {
      button.focus();
      button.click();
    }
  }
  document.addEventListener("astro:page-load", wire);
</script>

<style is:global>
  .drift {
    margin: 2rem 0;
  }

  .drift table {
    width: 100%;
  }

  .drift .live {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .drift figcaption {
    margin-top: 0.75rem;
    color: var(--at-text-secondary);
    font-size: 0.95rem;
  }
</style>
