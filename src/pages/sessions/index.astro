---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import SessionsGrid from "../../components/SessionsGrid.astro";
import { sessionLabels, siteConfig } from "../../site-config";
---

<ContentLayout
  title={sessionLabels.plural}
  description="Twelve Thursdays. Every studio ends with a number you produced, and this page is the list of them."
  {...siteConfig}
>
  <p>
    Read the right-hand column top to bottom and you have the course. The first
    five studios are unmarked. From week 6 each one is an entry in your{" "}
    <a href={`${import.meta.env.BASE_URL}/assessments/lab-book/`.replace(/\/\//g, "/")}>lab book</a>.
  </p>
  <SessionsGrid />
</ContentLayout>
