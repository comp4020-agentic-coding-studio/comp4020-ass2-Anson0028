---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import SessionsGrid from "../../components/SessionsGrid.astro";
import { sessionLabels, siteConfig } from "../../site-config";
---

<ContentLayout
  title={sessionLabels.plural}
  description="Twelve Thursdays. Every tutorial ends with a number you produced, and this page is the list of them."
  {...siteConfig}
>
  <p>
    Read what each week leaves you with, top to bottom, and you have the course. Every
    one ends with a five-minute{" "}
    <a href={`${import.meta.env.BASE_URL}/assessments/tutorial-quizzes/`.replace(/\/\//g, "/")}>quiz</a>{" "}
    that asks for the number you just measured.
  </p>
  <SessionsGrid />
</ContentLayout>
