---
import Schedule from "../components/Schedule.astro";
import BaseLayout from "astro-theme-university/layouts/BaseLayout.astro";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";

const curve = [
  { ms: 50, wins: 38 },
  { ms: 100, wins: 12 },
  { ms: 150, wins: 2 },
  { ms: 200, wins: 0 },
  { ms: 250, wins: 0 },
  { ms: 300, wins: 0 },
];
const RUNS = 51;
const base = import.meta.env.BASE_URL;
const link = (path: string) => `${base}${path}`.replace(/\/\//g, "/");

const suspects = [
  {
    id: "me",
    big: "Is it me",
    rows: [
      { week: 3, href: "/lectures/week-03/", name: "Give the player a reaction time", number: "12 of 15 → 1" },
      { week: 5, href: "/lectures/week-05/", name: "Even steps, uneven difficulty", number: "38 · 12 · 2 · 0" },
      { week: 11, href: "/lectures/week-11/", name: "Who fails the easy level", number: "1 in 51, or 41" },
    ],
  },
  {
    id: "game",
    big: "or is it the game?",
    rows: [
      { week: 6, href: "/lectures/week-06/", name: "Dead options", number: "magnet −11, nova −2" },
      { week: 7, href: "/lectures/week-07/", name: "Gates", number: "520 hp: 47 or 0" },
      { week: 8, href: "/lectures/week-08/", name: "Dominant strategies", number: "101.6 s vs 17.4 s" },
    ],
  },
];

---

<BaseLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  {...siteConfig}
>
  <section slot="hero" class="suspects" aria-labelledby="course-title">
    <h1 id="course-title" class="visually-hidden">{courseMeta.code}: {courseMeta.title}</h1>
    {suspects.map((side) => (
      <div class={`side ${side.id}`}>
        {side.id === "me" ? (
          <p class="sub">Measuring game balance without players</p>
        ) : (
          <p class="meta">{courseMeta.code} · {courseMeta.session} {courseMeta.year} · one game · 306 runs · nobody plays until week ten</p>
        )}
        <p class="big" aria-hidden="true">{side.big}</p>
        <ul>
          {side.rows.map((row) => (
            <li>
              <a href={link(row.href)}>
                <span class="wk">Week {row.week}</span>{" "}
                <span class="name">{row.name}</span>{" "}
                <span class="num">{row.number}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <p class="lead">{courseMeta.description}</p>

  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <figure class="runs">
    <div
      class="matrix"
      role="img"
      aria-label={`Wins out of ${RUNS} runs for a simulated player at six reaction times: ${curve.map((p) => `${p.ms} milliseconds, ${p.wins} wins`).join("; ")}.`}
    >
      {curve.map((point) => (
        <div class="run-row" data-ms={point.ms}>
          <span class="ms">{point.ms} ms</span>
          <span class="dots" style={`--wins:${point.wins}`}><i /><b /></span>
          <span class="count">{point.wins}</span>
        </div>
      ))}
    </div>
    <p class="run-it">
      <button type="button" id="run-51">Run all 306 in your browser</button>
      <span id="run-status" aria-live="polite"></span>
    </p>
    <figcaption>
      {curve.length * RUNS} runs of one two-minute game, none of them played by a
      person. A filled dot beat the game. The only thing that changes from row
      to row is the simulated player's reaction time. <a href={link("/lectures/week-05/")}>Week 5</a> is about why even steps are not even.
    </figcaption>
  </figure>

  <script>
    const button = document.getElementById("run-51") as HTMLButtonElement;
    const status = document.getElementById("run-status") as HTMLElement;
    const rows = [...document.querySelectorAll<HTMLElement>(".run-row")];
    const printed = rows.map((row) => Number(row.querySelector(".count")?.textContent));
    const low = [...printed];
    const high = [...printed];
    let batch = 0;
    button.addEventListener("click", async () => {
      button.disabled = true;
      status.textContent = batch === 0 ? "Loading the rules…" : "New seeds…";
      const { runRow } = await import("../scripts/run-51");
      const started = performance.now();
      const results: number[] = [];
      for (const row of rows) {
        const dots = row.querySelector<HTMLElement>(".dots")!;
        const count = row.querySelector<HTMLElement>(".count")!;
        const ms = Number(row.dataset.ms);
        status.textContent = `Running 51 at ${ms} ms…`;
        results.push(
          await runRow(ms, batch, (wins, done) => {
            dots.style.setProperty("--wins", String(wins));
            count.textContent = `${wins}`;
            dots.setAttribute("title", `${done} of 51 run`);
          }),
        );
      }
      const seconds = ((performance.now() - started) / 1000).toFixed(1);
      results.forEach((w, i) => {
        low[i] = Math.min(low[i], w);
        high[i] = Math.max(high[i], w);
      });
      const same = results.every((w, i) => w === printed[i]);
      if (batch === 0) {
        status.textContent = `${rows.length * 51} runs in ${seconds} s. ${
          same
            ? "The same six numbers the page printed."
            : `This browser got ${results.join(", ")}, ${results.reduce((d, w, i) => d + Math.abs(w - printed[i]), 0)} run${results.reduce((d, w, i) => d + Math.abs(w - printed[i]), 0) === 1 ? "" : "s"} off the printed row.`
        } Now try new seeds.`;
      } else {
        const spread = rows.map((row, i) => `${row.dataset.ms} ms ${low[i]}–${high[i]}`).join(", ");
        status.textContent = `Batch ${batch + 1}, fresh seeds: ${results.join(", ")}. Across ${batch + 1} batches each row has landed at: ${spread}. The numbers move; the cliff does not. Week 4 is about how many runs a claim needs.`;
      }
      batch++;
      button.textContent = "Run 306 with new seeds";
      button.disabled = false;
    });
  </script>

  <h2>What you will do</h2>
  <p>
    Spend twelve weeks measuring one small game, <em>Close Quarters</em>, a
    two-minute survival run with seven upgrades and two bosses. You will pull
    its rules away from its screen, write players that stand in for people, run
    it 51 times in a sixth of a second, and learn to read what comes back as a
    distribution instead of an anecdote.
  </p>
  <p>
    You will not play it until week ten. By then you will have nine weeks of
    predictions on paper, and the game gets to surprise you in a way you can
    write down.
  </p>
  <p>
    The game is live at <a href="https://comp4020-agentic-coding-studio.github.io/comp4020-crit5-Anson0028/">Close Quarters</a>.
    You are asked not to open it yet. Its rules are <a href="https://github.com/comp4020-agentic-coding-studio/comp4020-crit5-Anson0028/blob/main/rules.ts">eight hundred lines of TypeScript</a>,
    and those you may read now.
  </p>
  <p>
    You leave with one number: a change to one constant in that game, and a
    ten-minute case for it that three sceptical classmates could check.
  </p>

  <h2>Who it is for</h2>
  <p>
    People who make or mod games and are tired of balance arguments that nobody
    can lose. You need to be able to read and edit a few hundred lines of
    TypeScript. You do not need statistics beyond a median, and you do not need
    to be good at the game.
  </p>
  <p>
    It is a narrow course on purpose: single-player games only, simulation
    only. Multiplayer balance and playtesting with real people are different
    subjects, and week ten is honest about what that leaves out.
  </p>

  <h2>The semester, week by week</h2>
  <p>
    Tuesday is the claim, Thursday is the measurement. Five readings for the
    whole semester, one per block. Four pieces of assessment, each built from
    the one before.
  </p>
  <Schedule />
</BaseLayout>

<style is:global>
  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0 2rem;
    padding: 0;
    list-style: none;
  }

  .course-tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }

  .suspects {
    position: relative;
    z-index: 1;
    display: grid;
    grid-column: full;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .sub {
    margin: 0 0 auto;
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .meta {
    margin: 0 0 auto;
    text-align: right;
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: clamp(2rem, 6vw, 5rem) clamp(1rem, 5vw, 4.5rem) clamp(2rem, 4vw, 3.5rem);
  }

  .me {
    background: var(--at-bg-alt);
  }

  .game {
    color: light-dark(#fdfcf8, #1b1a17);
    background: light-dark(#1b1a17, #f0b94a);
  }

  .big {
    margin: 0;
    font-size: clamp(3.25rem, 8vw, 8.5rem);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .game .big {
    color: light-dark(#f0b94a, #1b1a17);
  }

  .side ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid currentColor;
  }

  .side a {
    display: grid;
    grid-template-columns: 4.5rem 1fr auto;
    gap: 0.25rem 1rem;
    align-items: baseline;
    padding-block: 0.85rem;
    color: inherit;
    text-decoration: none;
    border-top: 1px solid currentColor;
  }

  .side a:hover .name,
  .side a:focus-visible .name {
    text-decoration: underline;
  }

  .game a:focus-visible {
    outline-color: currentColor;
  }

  .meta,
  .wk,
  .num,
  .ms,
  .count {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .num {
    font-weight: 700;
  }

  .game .num {
    color: light-dark(#f0b94a, #1b1a17);
  }

  @media (max-width: 56rem) {
    .suspects {
      grid-template-columns: 1fr;
    }

    .side a {
      grid-template-columns: 4.5rem 1fr;
    }

    .num {
      grid-column: 2;
    }

    .meta {
      text-align: left;
    }
  }

  .lead {
    margin-top: 3rem;
  }

  .runs {
    margin: 2.5rem 0;
  }

  .matrix {
    display: grid;
    gap: 0.5rem;
    padding-block: 1.25rem;
    border-block: 2px solid var(--at-text);
  }

  .run-row {
    display: grid;
    grid-template-columns: 3.75rem 1fr 1.75rem;
    gap: 0.75rem;
    align-items: center;
  }

  .count {
    font-size: 1rem;
    font-weight: 700;
    text-align: right;
  }

  .dots {
    display: flex;
    container-type: inline-size;
  }

  .dots i,
  .dots b {
    --u: calc(100cqw / 51);
    height: var(--u);
    background-size: var(--u) var(--u);
  }

  .dots i {
    width: calc(var(--wins) * var(--u));
    background-image: radial-gradient(circle, var(--at-primary) 0 40%, transparent 44%);
  }

  .dots b {
    flex: 1;
    background-image: radial-gradient(circle, transparent 0 28%, var(--at-text-secondary) 32% 40%, transparent 44%);
  }

  @media (max-width: 40rem) {
    .run-row {
      grid-template-columns: 1fr auto;
      gap: 0.25rem;
    }

    .dots {
      grid-row: 2;
      grid-column: 1 / -1;
    }
  }

  .run-it {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: baseline;
    margin: 0.75rem 0 0;
  }

  .run-it button {
    padding: 0.5rem 0.9rem;
    border: 2px solid var(--at-text);
    border-radius: 0;
    background: var(--at-text);
    color: var(--at-bg);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .run-it button:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .run-it button:focus-visible {
    outline: 2px solid var(--at-primary);
    outline-offset: 2px;
  }

  #run-status {
    color: var(--at-text-secondary);
    font-size: 0.95rem;
  }

  .runs figcaption {
    margin-top: 0.75rem;
    max-width: 38rem;
    color: var(--at-text-secondary);
    font-size: 0.95rem;
  }
</style>
