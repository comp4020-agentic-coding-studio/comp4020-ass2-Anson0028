---
import ReactionLadder from "../components/ReactionLadder.astro";
import Schedule from "../components/Schedule.astro";
import BaseLayout from "astro-theme-university/layouts/BaseLayout.astro";
import { courseMeta } from "../course-config";
import { siteConfig } from "../site-config";

const base = import.meta.env.BASE_URL;
const link = (path: string) => `${base}${path}`.replace(/\/\//g, "/");

const suspects = [
  {
    id: "me",
    big: "Is it me",
    rows: [
      { week: 3, href: "/lectures/week-03/", name: "A perfect player describes nobody", number: "perfect player 12 of 15, slowed 1 of 15" },
      { week: 5, href: "/lectures/week-05/", name: "Even steps, uneven difficulty", number: "38, 12, 2, 0 wins of 51" },
      { week: 11, href: "/lectures/week-11/", name: "Every boss is easy for somebody", number: "first boss passed: 50 at 50 ms, 10 at 300 ms" },
    ],
  },
  {
    id: "game",
    big: "or is it the game?",
    rows: [
      { week: 6, href: "/lectures/week-06/", name: "A dead option looks like a live one", number: "ban pickup reach: 11 fewer wins of 51" },
      { week: 7, href: "/lectures/week-07/", name: "A gate everyone passes asks no question", number: "gate passed: 47 of 51, 0 with no cards" },
      { week: 8, href: "/lectures/week-08/", name: "The lazy strategy must lose", number: "go for experience 101.6 s, run away 52.5 s" },
    ],
  },
];

---

<BaseLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  {...siteConfig}
>
  <section slot="hero" class="suspects" aria-labelledby="course-title">
    <h1 id="course-title" class="visually-hidden">{courseMeta.code}: {courseMeta.title}</h1>
    <div class="band">
      <p class="sub">Measuring game balance without players</p>
      <p class="meta">{courseMeta.code} · {courseMeta.session} {courseMeta.year} · one game<span class="meta-tail"> · nobody plays until week ten</span></p>
      <p class="lead-top">{courseMeta.description}</p>
    </div>
    {suspects.map((side) => (
      <div class={`side ${side.id}`}>
        <p class="big" aria-hidden="true">{side.big}</p>
        <ul>
          {side.rows.map((row) => (
            <li>
              <a href={link(row.href)}>
                <span class="wk">Week {row.week}</span>{" "}
                <span class="name">{row.name}</span>{" "}
                <span class="num">{row.number}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <p class="lead lead-below">{courseMeta.description}</p>

  <h2>Start with “is it me”</h2>
  <p>
    Take one simulated player and make them slower, 50 ms at a time. Each row
    below is 51 runs at that reaction time, and a filled dot is a run that beat
    the game. If difficulty were only about you, the rows would shrink evenly.
    They do not.
  </p>
  <ReactionLadder>
    Nobody played any of these. <a href={link("/lectures/week-05/")}>Week 5</a> is about why even steps are not even.
  </ReactionLadder>


  <h2>What you will do, and who it is for</h2>
  <p>
    Twelve weeks measuring one small game, <a href="https://comp4020-agentic-coding-studio.github.io/comp4020-crit5-Anson0028/"><em>Close Quarters</em></a>,
    a two-minute survival run with seven upgrades and two bosses. It is live,
    linked here on purpose, and you are asked not to open it until week ten. Its rules are <a href="https://github.com/comp4020-agentic-coding-studio/comp4020-crit5-Anson0028/blob/main/rules.ts">eight hundred lines of TypeScript</a>,
    and those you may read now.
  </p>
  <p>
    You leave with one number: a change to one constant in that game, and a
    ten-minute case for it that three sceptical classmates could check.
  </p>
  <p>
    It is for people who make or mod games and are tired of balance arguments
    nobody can lose. You need to read and edit TypeScript. You do not need
    statistics beyond a median, and you do not need to be good at the game.
  </p>

  <h2>The semester, week by week</h2>
  <p>Tuesday is the claim, Thursday is the measurement.</p>
  <Schedule />
</BaseLayout>

<style is:global>
  .suspects {
    position: relative;
    z-index: 1;
    display: grid;
    grid-column: full;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .band {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: max-content 1fr;
    gap: 0.35rem 2rem;
    align-items: baseline;
    padding: 1.75rem clamp(1rem, 5vw, 4.5rem) 2rem;
    background: var(--at-bg);
  }

  .band::before {
    grid-column: 1 / -1;
    width: 3rem;
    height: 3px;
    margin-bottom: 0.4rem;
    background: var(--at-primary);
    content: "";
  }

  .band p {
    margin: 0;
  }

  .sub {
    max-inline-size: none;
    font-size: clamp(1.35rem, 2.2vw, 1.9rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .meta {
    color: var(--at-text-secondary);
    text-align: right;
  }

  .side {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 2rem;
    padding: clamp(2rem, 6vw, 5rem) clamp(1rem, 5vw, 4.5rem) clamp(2rem, 4vw, 3.5rem);
  }

  .me {
    background: var(--at-bg-alt);
  }

  .game {
    color: light-dark(#fdfcf8, #1b1a17);
    background: light-dark(#1b1a17, #f0b94a);
  }

  .big {
    margin: 0;
    font-size: clamp(3.25rem, 8vw, 8.5rem);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .game .big {
    color: light-dark(#f0b94a, #1b1a17);
  }

  .side ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid currentColor;
  }

  .side a {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 0.25rem 1rem;
    align-items: baseline;
    padding-block: 0.85rem;
    color: inherit;
    text-decoration: none;
    border-top: 1px solid currentColor;
  }

  .side a:hover .name,
  .side a:focus-visible .name {
    text-decoration: underline;
  }

  .game a:focus-visible {
    outline-color: currentColor;
  }

  .meta,
  .wk,
  .num,
  .ms,
  .count {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .num {
    font-weight: 700;
  }

  .game .num {
    color: light-dark(#f0b94a, #1b1a17);
  }

  .num {
    grid-column: 2;
  }

  @media (max-width: 56rem) {
    .suspects {
      grid-template-columns: 1fr;
    }

    .side a {
      grid-template-columns: 4.5rem 1fr;
    }

    .num {
      grid-column: 2;
    }

    .band {
      grid-template-columns: 1fr;
    }

    .meta {
      text-align: left;
    }

    .band .lead-top {
      display: block;
    }

    .meta-tail {
      display: none;
    }

    .lead-below {
      display: none;
    }
  }

  .lead {
    margin-top: 3rem;
  }

  .lead-top {
    display: none;
    margin-top: 0.75rem;
    max-inline-size: 40rem;
  }

  @media (min-width: 56rem) and (max-height: 54rem) {
    .big {
      font-size: clamp(3.25rem, min(8vw, 11vh), 8.5rem);
    }

    .side {
      gap: 1.25rem;
      padding-top: clamp(2rem, 6vh, 5rem);
    }
  }

</style>
