---
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import BaseLayout from "astro-theme-university/layouts/BaseLayout.astro";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";

const curve = [
  { ms: 50, wins: 38 },
  { ms: 100, wins: 12 },
  { ms: 150, wins: 2 },
  { ms: 200, wins: 0 },
  { ms: 250, wins: 0 },
  { ms: 300, wins: 0 },
];
const RUNS = 51;
const base = import.meta.env.BASE_URL;
const link = (path: string) => `${base}${path}`.replace(/\/\//g, "/");

const suspects = [
  {
    id: "me",
    big: "Is it me",
    rows: [
      { week: 3, href: "/lectures/week-03/", name: "Give the player a reaction time", number: "12 of 15 → 1" },
      { week: 5, href: "/lectures/week-05/", name: "Even steps, uneven difficulty", number: "38 · 12 · 2 · 0" },
      { week: 11, href: "/lectures/week-11/", name: "Who fails the easy level", number: "1 in 51, or 41" },
    ],
  },
  {
    id: "game",
    big: "or is it the game?",
    rows: [
      { week: 6, href: "/lectures/week-06/", name: "Dead options", number: "magnet −11, nova −2" },
      { week: 7, href: "/lectures/week-07/", name: "Gates", number: "520 hp: 47 or 0" },
      { week: 8, href: "/lectures/week-08/", name: "Dominant strategies", number: "101.6 s vs 17.4 s" },
    ],
  },
];

const blocks = [
  { weeks: "1–2", name: "The instrument", href: "/lectures/week-01/", line: "Turn an opinion into a prediction, and make the game run with no screen." },
  { weeks: "3–5", name: "Players and distributions", href: "/lectures/week-03/", line: "A player with a reaction time, 51 runs at a time, and dials that do not respond evenly." },
  { weeks: "6–8", name: "Options and gates", href: "/lectures/week-06/", line: "What each choice is worth, how big a wall has to be, and who wins by not playing properly." },
  { weeks: "9–10", name: "The edges of measurement", href: "/lectures/week-09/", line: "How the instrument lies without going red. Then you finally play the game." },
  { weeks: "11–12", name: "Different players", href: "/lectures/week-11/", line: "The same boss stops 1 player in 51 or 41 in 51. Pick a number and defend it." },
];
---

<BaseLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  {...siteConfig}
>
  <section slot="hero" class="suspects" aria-labelledby="course-title">
    <h1 id="course-title" class="visually-hidden">{courseMeta.code}: {courseMeta.title}</h1>
    <div class="band">
      <p class="sub">Measuring game balance without players</p>
      <p class="meta">{courseMeta.code} · {courseMeta.session} {courseMeta.year} · nobody plays until week ten</p>
    </div>
    {suspects.map((side) => (
      <div class={`side ${side.id}`}>
        <p class="big" aria-hidden="true">{side.big}</p>
        <ul>
          {side.rows.map((row) => (
            <li>
              <a href={link(row.href)}>
                <span class="wk">Week {row.week}</span>
                <span class="name">{row.name}</span>
                <span class="num">{row.number}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <p class="lead">{courseMeta.description}</p>

  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <figure class="runs">
    <div
      class="matrix"
      role="img"
      aria-label={`Wins out of ${RUNS} runs for a simulated player at six reaction times: ${curve.map((p) => `${p.ms} milliseconds, ${p.wins} wins`).join("; ")}.`}
    >
      {curve.map((point) => (
        <div class="run-row">
          <span class="ms">{point.ms} ms</span>
          <span class="dots" style={`--wins:${point.wins}`}><i /><b /></span>
          <span class="count">{point.wins}</span>
        </div>
      ))}
    </div>
    <figcaption>
      {curve.length * RUNS} runs of one two-minute game. Nobody played any of
      them. A filled dot beat the game. The only thing that changes from row to
      row is the simulated player's reaction time, in six even steps of 50 ms.
      The first step costs 26 wins. The fourth costs none. <a href={link("/lectures/week-05/")}>Week 5</a> is about why.
    </figcaption>
  </figure>

  <h2>What you will do</h2>
  <p>
    Spend twelve weeks measuring one small game, <em>Close Quarters</em>, a
    two-minute survival run with seven upgrades and two bosses. You will pull
    its rules away from its screen, write players that stand in for people, run
    it 51 times in a sixth of a second, and learn to read what comes back as a
    distribution instead of an anecdote.
  </p>
  <p>
    You will not play it until week ten. By then you will have nine weeks of
    predictions on paper, and the game gets to surprise you in a way you can
    write down.
  </p>
  <p>
    You leave with one number: a change to one constant in that game, and a
    ten-minute case for it that three sceptical classmates could check.
  </p>

  <h2>Who it is for</h2>
  <p>
    People who make or mod games and are tired of balance arguments that nobody
    can lose. You need to be able to read and edit a few hundred lines of
    TypeScript. You do not need statistics beyond a median, and you do not need
    to be good at the game.
  </p>
  <p>
    It is a narrow course on purpose: single-player games only, simulation
    only. Multiplayer balance and playtesting with real people are different
    subjects, and week ten is honest about what that leaves out.
  </p>

  <h2>The semester in five blocks</h2>
  <ol class="blocks">
    {blocks.map((block) => (
      <li>
        <span class="weeks">Weeks {block.weeks}</span>
        <a href={`${import.meta.env.BASE_URL}${block.href}`.replace(/\/\//g, "/")}>{block.name}</a>
        <span class="line">{block.line}</span>
      </li>
    ))}
  </ol>

  <h2>Where to go next</h2>
  <CardGrid columns={2}>
    <Card title="Lectures" href="/lectures/">
      <p>Twelve weeks, one claim a week, every one of them about the same game.</p>
    </Card>
    <Card title={sessionLabels.plural} href="/sessions/">
      <p>What you measure each Thursday, and the number you leave with.</p>
    </Card>
    <Card title="Assessment" href="/assessments/">
      <p>Four pieces that feed each other: a curve, a point on it, a lab book, a defence.</p>
    </Card>
    <Card title="People" href="/people/">
      <p>Who teaches the course and how to reach them.</p>
    </Card>
  </CardGrid>
</BaseLayout>

<style is:global>
  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0 2rem;
    padding: 0;
    list-style: none;
  }

  .course-tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }

  .suspects {
    position: relative;
    z-index: 1;
    display: grid;
    grid-column: full;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .band {
    display: flex;
    flex-wrap: wrap;
    grid-column: 1 / -1;
    gap: 0.25rem 2rem;
    align-items: baseline;
    justify-content: space-between;
    padding: 1.25rem clamp(1rem, 5vw, 4.5rem);
    background: var(--at-bg);
    border-block: 2px solid var(--at-text);
  }

  .band p {
    margin: 0;
  }

  .sub {
    font-size: clamp(1.35rem, 2.4vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .side {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 2rem;
    padding: clamp(2rem, 6vw, 5rem) clamp(1rem, 5vw, 4.5rem) clamp(2rem, 4vw, 3.5rem);
  }

  .me {
    background: var(--at-bg-alt);
  }

  .game {
    color: light-dark(#fdfcf8, #1b1a17);
    background: light-dark(#1b1a17, #f0b94a);
  }

  .big {
    margin: 0;
    font-size: clamp(3.25rem, 8vw, 8.5rem);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .game .big {
    color: light-dark(#f0b94a, #1b1a17);
  }

  .side ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid currentColor;
  }

  .side a {
    display: grid;
    grid-template-columns: 4.5rem 1fr auto;
    gap: 0.25rem 1rem;
    align-items: baseline;
    padding-block: 0.85rem;
    color: inherit;
    text-decoration: none;
    border-top: 1px solid currentColor;
  }

  .side a:hover .name,
  .side a:focus-visible .name {
    text-decoration: underline;
  }

  .game a:focus-visible {
    outline-color: currentColor;
  }

  .meta,
  .wk,
  .num,
  .ms,
  .count {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .num {
    font-weight: 700;
  }

  .game .num {
    color: light-dark(#f0b94a, #1b1a17);
  }

  @media (max-width: 56rem) {
    .suspects {
      grid-template-columns: 1fr;
    }

    .side a {
      grid-template-columns: 4.5rem 1fr;
    }

    .num {
      grid-column: 2;
    }
  }

  .lead {
    margin-top: 3rem;
  }

  .runs {
    margin: 2.5rem 0;
  }

  .matrix {
    display: grid;
    gap: 0.5rem;
    padding-block: 1.25rem;
    border-block: 2px solid var(--at-text);
  }

  .run-row {
    display: grid;
    grid-template-columns: 3.75rem 1fr 1.75rem;
    gap: 0.75rem;
    align-items: center;
  }

  .count {
    font-size: 1rem;
    font-weight: 700;
    text-align: right;
  }

  .dots {
    display: flex;
    container-type: inline-size;
  }

  .dots i,
  .dots b {
    --u: calc(100cqw / 51);
    height: var(--u);
    background-size: var(--u) var(--u);
  }

  .dots i {
    width: calc(var(--wins) * var(--u));
    background-image: radial-gradient(circle, var(--at-primary) 0 40%, transparent 44%);
  }

  .dots b {
    flex: 1;
    background-image: radial-gradient(circle, transparent 0 28%, var(--at-text-secondary) 32% 40%, transparent 44%);
  }

  @media (max-width: 40rem) {
    .run-row {
      grid-template-columns: 1fr auto;
      gap: 0.25rem;
    }

    .dots {
      grid-row: 2;
      grid-column: 1 / -1;
    }
  }

  .runs figcaption {
    margin-top: 0.75rem;
    max-width: 38rem;
    color: var(--at-text-secondary);
    font-size: 0.95rem;
  }

  .blocks {
    display: grid;
    gap: 0.9rem;
    padding: 0;
    list-style: none;
  }

  .blocks li {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    column-gap: 1rem;
  }

  .blocks .weeks {
    grid-row: span 2;
    color: var(--at-text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .blocks a {
    font-weight: 600;
  }

  .blocks .line {
    color: var(--at-text-secondary);
  }

  @media (max-width: 30rem) {
    .blocks li {
      grid-template-columns: 1fr;
    }

    .blocks .weeks {
      grid-row: auto;
    }
  }
</style>
